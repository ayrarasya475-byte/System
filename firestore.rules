rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helpers
    function isSignedIn() { return request.auth != null; }
    function isEmailVerified() { return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com'); }
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == 'ayrarasya475@gmail.com' ||
        exists(/databases/$(database)/documents/admin_authorizations/$(request.auth.uid))
      );
    }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Prompts
    match /prompts/{promptId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'copyCount', 'downloadCount'])
      );
      allow delete: if isAdmin();
    }

    // Models
    match /models/{modelId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Suggestions
    match /suggestions/{suggestionId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Chat Sessions (sessionId is the userId)
    match /chat_sessions/{sessionId} {
      allow read: if isAdmin() || isOwner(sessionId);
      allow create: if isSignedIn() && sessionId == request.auth.uid;
      allow update: if isAdmin() || isOwner(sessionId);
      allow delete: if isAdmin();
    }

    match /chat_sessions/{sessionId}/messages/{messageId} {
      allow read: if isAdmin() || isOwner(sessionId);
      allow create: if (isAdmin() || isOwner(sessionId)) && incoming().senderId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // User audit collection
    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow write: if isOwner(userId);
    }

    // Prompt likes mapping
    match /prompt_likes/{likeId} {
      allow read: if true;
      allow create: if isSignedIn() && likeId.endsWith(request.auth.uid);
      allow delete: if isAdmin() || likeId.endsWith(request.auth.uid);
    }

    // Admin Authorization Self-Service
    match /admin_authorizations/{uid} {
      allow read: if isSignedIn();
      allow create: if request.auth.uid == uid && incoming().passcode == '92727292827';
      allow update: if request.auth.uid == uid && incoming().passcode == '92727292827';
      allow delete: if request.auth.uid == uid;
    }

    match /stats_logs/{logId} {
      allow read: if isAdmin();
      allow create: if true;
    }
  }
}
